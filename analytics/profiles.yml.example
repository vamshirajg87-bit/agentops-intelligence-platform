# profiles.yml.example
#
# Safe template — committed to version control.
# Copy to profiles.yml and set the required environment variables before use.
# profiles.yml is listed in analytics/.gitignore and must never be committed.
#
# Usage (PowerShell):
#   $env:DBT_PG_PASSWORD = "agentops_dev"        # required — no default
#   $env:DBT_PG_HOST     = "localhost"            # optional — default shown
#   $env:DBT_PG_PORT     = "5432"                # optional — default shown
#   $env:DBT_PG_DATABASE = "agentops"            # optional — default shown
#   $env:DBT_PG_USER     = "agentops"            # optional — default shown
#   $env:DBT_PG_SCHEMA   = "analytics"           # optional — default shown
#
# Usage (bash/zsh):
#   export DBT_PG_PASSWORD="agentops_dev"
#
# Run from the analytics/ directory:
#   cd analytics
#   dbt debug
#   dbt run

agentops:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_PG_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PG_PORT', '5432') | int }}"
      dbname: "{{ env_var('DBT_PG_DATABASE', 'agentops') }}"
      user: "{{ env_var('DBT_PG_USER', 'agentops') }}"
      password: "{{ env_var('DBT_PG_PASSWORD') }}"
      schema: "{{ env_var('DBT_PG_SCHEMA', 'analytics') }}"
      threads: 2
