# Grafana -> PostgreSQL datasource password for the grafana_reader role.
# Copy this file to .env and fill in the value before running docker compose up.
# The value must match the password set when applying:
#   storage-consumer/migrations/002_create_grafana_reader.sql
GF_DATASOURCE_AGENTOPS_PASSWORD=

# Trace Viewer -> PostgreSQL password for the trace_viewer_reader role.
# The value must match the password set when applying:
#   storage-consumer/migrations/003_create_trace_viewer_reader.sql
TRACE_VIEWER_DB_PASSWORD=
