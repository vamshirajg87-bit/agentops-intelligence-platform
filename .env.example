# AgentOps local deployment configuration.
#
# Copy this file to .env and give every variable in the first section a value
# before running `docker compose up`.  .env is ignored by git; never commit it.
#
# Every value below is deliberately EMPTY.  Nothing here is a usable
# credential and nothing starts until you have chosen your own:
#   - without POSTGRES_PASSWORD or GF_DATASOURCE_AGENTOPS_PASSWORD, Compose
#     refuses to start anything;
#   - without one of the other role passwords, the database bootstrap stops
#     before it changes anything and names the missing variable.
#
# These are development credentials for a stack on your own machine.  Use a
# different value for each, on one line, without quotes.

# ---------------------------------------------------------------------------
# Required: database and bootstrap
# ---------------------------------------------------------------------------

# PostgreSQL owner/administrator (role "agentops").  PostgreSQL uses it when
# it first creates its data directory, and the bootstrap uses it to apply the
# migrations.  Changing it later does not change an existing database.
POSTGRES_PASSWORD=

# One password per application role.  The bootstrap creates each role with
# the value given here; the service that logs in as that role reads the same
# variable.

# grafana_reader - Grafana's PostgreSQL data source (used by Compose today).
GF_DATASOURCE_AGENTOPS_PASSWORD=

# trace_viewer_reader - trace viewer.
TRACE_VIEWER_DB_PASSWORD=

# anomaly_detector - anomaly detector.
ANOMALY_DETECTOR_DB_PASSWORD=

# rca_analyzer - RCA analyzer.
RCA_ANALYZER_DB_PASSWORD=

# incident_retrieval - incident retrieval.
INCIDENT_RETRIEVAL_DB_PASSWORD=

# alert_evaluator - alert evaluation and guardrails.
ALERT_EVALUATOR_DB_PASSWORD=

# alert_notifier - alert notification and its admin commands.
ALERT_NOTIFIER_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Not read by Compose: Python services and tools run on the host
# ---------------------------------------------------------------------------
#
# A process started on the host does not read .env by itself; export what it
# needs in its own shell.  The role services read the variables above.  These
# additional names exist:
#
#   PG_PASSWORD                            storage consumer; it connects as
#                                          the owner role, so this must equal
#                                          POSTGRES_PASSWORD.  No default.
#   DBT_PG_PASSWORD                        read by the dbt profile.  The
#                                          bootstrap and the analytics refresh
#                                          set it themselves; you do not.
#   ALERTING_E2E_ADMIN_PASSWORD            opt-in live test suites only.
#   INCIDENT_RETRIEVAL_E2E_ADMIN_PASSWORD  opt-in live test suites only.
#
# Analytics models are rebuilt with one command:
#
#   docker compose run --rm analytics-refresh
#
# It runs dbt, re-applies db-bootstrap/post_dbt_grants.sql (a dbt run removes
# those grants) and verifies every analytics grant.  It needs only
# POSTGRES_PASSWORD from this file.  Do not run dbt directly against a
# platform database: the grants would stay missing.
#
# Alert webhooks are optional.  A webhook channel in the alert policy names
# the environment variables that hold its URL and token; there are no fixed
# names for them here.
